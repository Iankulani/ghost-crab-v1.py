# ============================================
# GHOST-CRAB-V1 - Environment Variables
# Copy to .env and modify
# ============================================

# Application
GHOST_CRAB_ENV=production
GHOST_CRAB_LOG_LEVEL=INFO
GHOST_CRAB_SECRET_KEY=your-super-secret-key-change-this
GHOST_CRAB_VERSION=1.0.0

# Web Dashboard
GHOST_CRAB_WEB_PORT=5000
GHOST_CRAB_WEB_HOST=0.0.0.0
GHOST_CRAB_WEB_USERNAME=admin
GHOST_CRAB_WEB_PASSWORD=ghostcrab123

# Database
GHOST_CRAB_DB_PATH=/app/.ghost_crab_v1/ghost_crab_v1.db
POSTGRES_PASSWORD=ghostcrab123
MONGO_PASSWORD=ghostcrab123
REDIS_PASSWORD=ghostcrab123

# Discord Bot
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CHANNEL_ID=your-channel-id
DISCORD_PREFIX=!

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
TELEGRAM_PREFIX=/

# Slack Bot
SLACK_BOT_TOKEN=xoxb-your-slack-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL_ID=your-channel-id
SLACK_PREFIX=!

# WhatsApp
WHATSAPP_PHONE_NUMBER=+1234567890
WHATSAPP_ENABLED=false

# Signal
SIGNAL_PHONE_NUMBER=+1234567890
SIGNAL_GROUP_ID=
SIGNAL_ENABLED=false

# Google Chat
GOOGLE_CHAT_WEBHOOK_URL=your-webhook-url
GOOGLE_CHAT_ENABLED=false

# Email/SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_TLS=true

# API Keys
VIRUSTOTAL_API_KEY=your-virustotal-key
SHODAN_API_KEY=your-shodan-key
ABUSEIPDB_API_KEY=your-abuseipdb-key
IPINFO_API_KEY=your-ipinfo-key

# SaaS
SAAS_ENABLED=true
SAAS_TRIAL_DAYS=14
SAAS_FREE_TIER_SCANS=10
SAAS_BASIC_TIER_SCANS=100
SAAS_PRO_TIER_SCANS=1000

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_PASSWORD=ghostcrab123
ELASTICSEARCH_ENABLED=true

# Security
JWT_SECRET_KEY=your-jwt-secret
ENCRYPTION_KEY=your-encryption-key
API_RATE_LIMIT=1000
SESSION_TIMEOUT=3600

# Notifications
SLACK_WEBHOOK_URL=your-slack-webhook
DISCORD_WEBHOOK_URL=your-discord-webhook
TELEGRAM_WEBHOOK_URL=your-telegram-webhook

# C2 Configuration
C2_HOST=0.0.0.0
C2_PORT=4444
C2_CALLBACK_INTERVAL=60

# Metasploit
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55552
MSF_RPC_USER=msf
MSF_RPC_PASSWORD=your-msf-password

# Docker
DOCKER_HOST=unix:///var/run/docker.sock

# Paths
PAYLOADS_DIR=/app/.ghost_crab_v1/payloads
REPORTS_DIR=/app/reports
LOGS_DIR=/app/logs
